# ---------------------------------------------------------------------------
# Corre y Liberate 2026 — variables de entorno
#
# Copia este archivo a `.env.local` para desarrollo. El esquema que las valida
# vive en `src/lib/env.ts`: si falta una obligatoria o llega con formato
# invalido, el build falla ahi y no en produccion.
# ---------------------------------------------------------------------------

# URL publica y canonica del sitio. Alimenta `metadataBase`, el sitemap, el
# robots.txt y las URLs absolutas de Open Graph.
#   produccion  -> https://correyliberate.com
#   development -> la preview de Vercel de la rama `development`
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Nombre del entorno. Controla si el sitio se deja indexar: solo `production`
# emite `index, follow`; el resto pide `noindex` para que las previews no
# compitan en buscadores con el sitio real.
#   production | development | preview
NEXT_PUBLIC_APP_ENV="development"

# ---------------------------------------------------------------------------
# Supabase (formulario de inscripcion). Opcionales: sin ellas /inscripcion
# responde 404 y el resto del sitio funciona igual.
# Supabase > Project Settings > API Keys.
#   NEXT_PUBLIC_SUPABASE_URL             https://<proyecto>.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY sb_publishable_... (publica por diseno)
#   SUPABASE_SECRET_KEY                  sb_secret_... SOLO servidor: salta RLS
#                                        y lee todas las inscripciones.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
