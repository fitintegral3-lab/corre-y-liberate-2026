# ---------------------------------------------------------------------------
# Corre y Liberate 2026 — variables de entorno
#
# Copia este archivo a `.env.local` para desarrollo. El esquema que las valida
# vive en `src/lib/env.ts`: si falta una obligatoria o llega con formato
# invalido, el build falla ahi y no en produccion.
# ---------------------------------------------------------------------------

# URL publica y canonica del sitio. Alimenta `metadataBase`, el sitemap, el
# robots.txt y las URLs absolutas de Open Graph.
#   produccion  -> https://correyliberate.com
#   development -> la preview de Vercel de la rama `development`
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Nombre del entorno. Controla si el sitio se deja indexar: solo `production`
# emite `index, follow`; el resto pide `noindex` para que las previews no
# compitan en buscadores con el sitio real.
#   production | development | preview
NEXT_PUBLIC_APP_ENV="development"

# ---------------------------------------------------------------------------
# Supabase (formulario de inscripcion). Opcionales: sin ellas /inscripcion
# responde 404 y el resto del sitio funciona igual.
# Supabase > Project Settings > API Keys.
#   SUPABASE_URL                         https://<proyecto>.supabase.co
#   (el navegador no habla con Supabase: ninguna lleva NEXT_PUBLIC_)
#   SUPABASE_SECRET_KEY                  sb_secret_... SOLO servidor: salta RLS
#                                        y lee todas las inscripciones.
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Hoja de Google Drive (copia de cada inscripcion). Opcionales: sin ellas las
# inscripciones se guardan igual en Supabase y solo no se copian.
# Salen del JSON de la cuenta de servicio de Google Cloud; la hoja tiene que
# estar compartida con ese correo como Editor.
#   GOOGLE_SHEETS_SPREADSHEET_ID        lo que va entre /d/ y /edit en la URL
#   GOOGLE_SERVICE_ACCOUNT_EMAIL        client_email del JSON
#   GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY  private_key del JSON, en una linea con \n
#   GOOGLE_SHEETS_TAB                   pestana; por defecto Inscripciones
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SHEETS_TAB="Inscripciones"

# ---------------------------------------------------------------------------
# Comprobantes de pago en Google Cloud Storage (obligatorio para /inscripcion).
# Bucket privado del proyecto corre-y-liberate. Usa la misma cuenta de servicio
# de la hoja (GOOGLE_SERVICE_ACCOUNT_*), que necesita en el bucket los roles
# "Creador de objetos de Storage" y "Visualizador de objetos de Storage".
# ---------------------------------------------------------------------------
GCS_RECEIPTS_BUCKET=""

# ---------------------------------------------------------------------------
# Correos al corredor, desde Gmail (opcionales: sin ellas no se envian).
#   GMAIL_USER             cuenta que envia, p. ej. fitintegral3@gmail.com
#   GMAIL_APP_PASSWORD     contrasena de aplicacion de Google (16 caracteres);
#                          exige verificacion en 2 pasos en esa cuenta
#   EMAIL_FROM_NAME        nombre del remitente; por defecto Corre y Libérate
#   SUPABASE_WEBHOOK_SECRET  secreto que Supabase manda en x-webhook-secret al
#                          avisar un cambio de pago (correos de aprobado/rechazado)
# ---------------------------------------------------------------------------
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM_NAME="Corre y Libérate"
SUPABASE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Administracion de pagos en /p/<ADMIN_SLUG> (opcional: sin estas variables no
# existe y responde 404). La direccion no esta en el repositorio; el navegador
# pide usuario y contrasena. ADMIN_SLUG de 16+ caracteres (letras, numeros, - _)
# y ADMIN_PASSWORD de 16+ caracteres. Generarlos con openssl, no inventarlos.
# ---------------------------------------------------------------------------
ADMIN_SLUG=""
ADMIN_USER=""
ADMIN_PASSWORD=""
