{
  "name": "corre-y-liberate-2026",
  "version": "2.0.0",
  "private": true,
  "description": "Landing oficial de la carrera atletica Corre y Liberate 2026 — Jamundi, Valle del Cauca.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "ops": "node ops/tools/ops.js",
    "ops:check": "node ops/tools/ops.js check ops/planning",
    "ops:tree": "node ops/tools/ops.js tree ops/planning",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
